          "snippet": {
            "text": "noncomputable def bound_4_32 (x δ : ℝ) (q : ℕ) (D Q₀ ε : ℝ) : ℝ :=\n  let c₁ := 1 + eta2'L1 / (x / D)\n  let y := x / (|δ| * q)\n  2 * √(c₀ * c₁) / π *\n      (D + (1 + ε) * min ((⌊y⌋₊ : ℝ) + 1) (2 * D) * (√(3 + 2 * ε) + 1 / 2 * logPlus (2 * D / y))) +\n    3 / 2 * c₁ * (2 + (1 + ε) / ε * logPlus (2 * D / y)) * (x / Q₀) +\n    35 * c₀ * c₂ / (3 * π ^ 2) * q",
