          "snippet": {
            "text": "/-- `√a √b ≤ (a/s + s b)/2`. -/\ntheorem sqrt_mul_sqrt_le {a b s : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (hs : 0 < s) :\n    √a * √b ≤ (a / s + s * b) / 2 := by\n  rw [← Real.sqrt_mul ha]\n  rw [Real.sqrt_le_left (by positivity)]\n  have : (a / s + s * b) ^ 2 - 4 * (a * b) = (a / s - s * b) ^ 2 := by field_simp; ring\n  nlinarith [sq_nonneg (a / s - s * b)]",
