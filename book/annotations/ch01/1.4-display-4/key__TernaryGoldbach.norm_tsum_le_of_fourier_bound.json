          "snippet": {
            "text": "theorem norm_tsum_le_of_fourier_bound {f : ℝ → ℂ} (hf : Continuous f) (hfs : HasCompactSupport f)\n    {K : ℝ} (hK : ∀ t, (2 * π * t) ^ 2 * ‖𝓕 f t‖ ≤ K) {α : ℝ} (hα : Real.sin (π * α) ≠ 0) :\n    ‖∑' n : ℤ, f n * e (α * n)‖ ≤ K / (4 * Real.sin (π * α) ^ 2) := by",
            "line": 214,
            "truncated": false
          },
          "proof_context": {
            "declaration": "TernaryGoldbach.norm_tsum_le_of_fourier_bound",
            "lines": [
