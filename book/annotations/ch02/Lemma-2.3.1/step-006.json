            "text": "  have hpt : ∀ n : ℤ, ‖𝓕 g n‖ ≤ K / (4 * π ^ 2) * (1 / ((n : ℝ) - α) ^ 2) := by\n    intro n\n    rw [fourier_mul_e]\n    have h := hK (n - α)\n    have hpos : 0 < (2 * π * ((n : ℝ) - α)) ^ 2 := by\n      have := hαn n; positivity\n    rw [show K / (4 * π ^ 2) * (1 / ((n : ℝ) - α) ^ 2) = K / (2 * π * ((n : ℝ) - α)) ^ 2 by\n      field_simp; ring]\n    rw [le_div_iff₀ hpos]; linarith",
