          "snippet": {
            "text": "theorem Todd_eq (α x : ℝ) (m : ℕ) :\n    Todd α x m = e (α * m) * ∑' r : ℤ, fodd x m r * e (2 * α * m * r) := by\n  rw [Todd, ← tsum_mul_left]\n  refine tsum_congr fun r => ?_\n  simp only [fodd]\n  rw [show (2 * m / x * (r : ℝ) + m / x) = m * (2 * r + 1) / x by ring,\n    show α * m * (2 * r + 1) = α * m + 2 * α * m * r by ring, e_add]\n  ring",
            "line": 102,
            "truncated": false
          },
