          "snippet": {
            "line": 89,
            "text": "noncomputable def repSum (P : ℕ → Prop) (N : ℕ) : ℝ :=\n  ∑ n₁ ∈ Finset.range (N + 1), ∑ n₂ ∈ Finset.range (N + 1), ∑ n₃ ∈ Finset.range (N + 1),\n    if n₁ + n₂ + n₃ = N ∧ P n₁ ∧ P n₂ ∧ P n₃ then\n      Λ n₁ * Λ n₂ * Λ n₃ * etaPlus (n₁ / xOf N) * etaPlus (n₂ / xOf N) *\n        etaStar (n₃ / xOf N)\n    else 0",
            "truncated": false
          }
        }
      },
