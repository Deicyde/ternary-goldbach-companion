          "snippet": {
            "text": "theorem abs_Nodd_sub_le {S y : ℝ} (hy : 1 ≤ y) (hyS : y ≤ S) : |Nodd S y - S / (4 * y)| ≤ 1 := by\n  rw [Nodd_eq hy hyS]\n  have hy0 : 0 < y := by linarith\n  have hS0 : 0 < S := by linarith\n  have h := abs_card_odd_sub_le (α := S / (2 * y)) (by positivity)\n  have e : S / (2 * y) / 2 = S / (4 * y) := by ring\n  rwa [e] at h",
            "line": 199,
            "truncated": false
          },
          "proof_context": {
            "declaration": "TernaryGoldbach.MinorArcs.abs_Nodd_sub_le",
            "lines": [
              199,
              205
            ],
            "conclusion": "$|N_S(y)-S/(4y)|\\le1$, the odd-integer count in $(\\alpha,2\\alpha]$ equals $S/4y$ up to $1$."
          },
