            "text": "theorem log_le_harmonic_floor (y : ℝ) (hy : 0 ≤ y) :\n    Real.log y ≤ harmonic ⌊y⌋₊ := by\n  by_cases h0 : y = 0\n  · simp [h0]\n  · calc\n      _ ≤ Real.log ↑(Nat.floor y + 1) := ?_\n      _ ≤ _ := log_add_one_le_harmonic _\n    gcongr\n    apply (Nat.le_ceil y).trans\n    norm_cast",
            "line": 60,
            "truncated": false
          },
