            "text": "theorem moebius_mul_ramanujan {q : ℕ} (hq : Squarefree q) (n : ℕ) :\n    (μ q : ℂ) * ∑ a ∈ (range q).filter q.Coprime, e (a * n / q) =\n      ((∏ p ∈ q.primeFactors, (1 - divW n p) : ℝ) : ℂ) :=",
