            "declaration": "log_le_harmonic_floor",
            "lines": [
              60,
              70
            ],
            "conclusion": "log y ≤ ∑_{d ≤ ⌊y⌋} 1/d (harmonic ⌊y⌋) for all real y ≥ 0."
