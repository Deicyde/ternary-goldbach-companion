          "snippet": {
            "text": "theorem sum_window_le {S : Finset ℂ} (m : ℂ → ℝ) (hm : ∀ u ∈ S, 0 ≤ m u) {h T0 Z : ℝ} (hh : 0 < h)\n    (J : ℕ) (hJ : T0 < J * h) (hS : ∀ u ∈ S, |u.im| ≤ T0) (hZ0 : 0 ≤ Z)\n    (hZ : ∀ k : ℕ, ∑ u ∈ S.filter (fun u => (⌊u.im / h⌋ + J).toNat = k), m u ≤ Z)\n    {f f' : ℝ → ℂ} (hf : ∀ t, HasDerivAt f (f' t) t) (hf' : Continuous f') :\n    ∑ u ∈ S, m u * ‖f u.im‖ ≤\n      Z * ((1 / h) * (∫ t in (-(J * h))..(J * h), ‖f t‖) + ∫ t in (-(J * h))..(J * h), ‖f' t‖) :=",
