            "text": "noncomputable def bound_4_50 (x δ : ℝ) (q : ℕ) (U V : ℝ) : ℝ :=\n  let D := U * V\n  x / (2 * q) * minInv c₀ (π * δ) * Real.log (V * q) +\n    (1 / 4 - 1 / π ^ 2) * c₀ *\n      (D ^ 2 * Real.log V / (2 * q * x) + 3 * c₄ / 2 * (U * V ^ 2 / x) +\n        3 / 2 * ((U + 1) ^ 2 * V / (2 * x) * Real.log q))",
