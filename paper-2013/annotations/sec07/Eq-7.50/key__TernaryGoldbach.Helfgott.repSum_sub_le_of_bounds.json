          "snippet": {
            "line": 112,
            "text": "theorem repSum_sub_le_of_bounds {N : ℕ} (hN : 1 ≤ N) {Ap As : ℝ}\n    (hAp : ∀ t, 0 ≤ t → |etaPlus t| ≤ Ap) (hAs : ∀ t, 0 ≤ t → |etaStar t| ≤ As) :\n    repSum (fun _ => True) N - repSum Good N ≤\n      3 * (Ap ^ 2 * As) * Real.log N * (psi N - theta N + Real.log 2) * psi N :=",
            "truncated": false
          }
        }
