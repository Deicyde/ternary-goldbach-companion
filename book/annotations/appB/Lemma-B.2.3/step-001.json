            "id": "TernaryGoldbach.MinorArcs.hasDerivAt_lg1'"
          },
          "snippet": {
            "text": "theorem hasDerivAt_lg1' {u : ℝ} (hu : 0 < u) : HasDerivAt lg1' (lg1'' u) u := by\n  have h1 := ((hasDerivAt_id u).const_mul 4).log (by simp; positivity)\n  have h2 := Real.hasDerivAt_log hu.ne'\n  convert ((h1.add h2).const_mul 4).div (hasDerivAt_id u) hu.ne' using 1\n  · ext v; simp [lg1']\n  · simp only [lg1'', id, Pi.add_apply]; field_simp; ring",
            "line": 97,
            "truncated": false
          },
          "proof_context": {
            "declaration": "TernaryGoldbach.MinorArcs.hasDerivAt_lg1'",
            "lines": [
              97,
              102
            ],
            "conclusion": "The derivative of `lg1'` (= (log·η₂)' on (1/4,1/2)) is `lg1''(u) = 4(2 - log 4u - log u)/u^2`."
          },
          "destination": {
            "resolution": "exact",
