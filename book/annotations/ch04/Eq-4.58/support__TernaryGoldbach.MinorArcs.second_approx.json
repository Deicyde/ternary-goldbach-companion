            "text": "theorem second_approx {ξ Q ε : ℝ} {a : ℤ} {q : ℕ} (hq : 1 ≤ q) (hcop : IsCoprime a (q : ℤ))\n    (hqQ : (q : ℝ) ≤ Q) (hε : 0 < ε) (hexact : |ξ - a / q| = 1 / (q * Q)) :\n    ∃ (a' : ℤ) (q' : ℕ), 1 ≤ q' ∧ IsCoprime a' (q' : ℤ) ∧ (q' : ℝ) ≤ (1 + ε) * Q ∧\n      |ξ - a' / q'| ≤ 1 / (q' * ((1 + ε) * Q)) ∧ ε * Q / (1 + ε) ≤ q' :=",
