          "snippet": {
            "text": "theorem vaughan_apply {U V n : ℕ} (hn : V < n) :\n    Λ n = (trunc μ U * log) n - (trunc μ U * trunc Λ V * ζ) n +\n      (((μ : ArithmeticFunction ℝ) - trunc μ U) * (Λ - trunc Λ V) * ζ) n := by\n  have h := congrArg (fun f : ArithmeticFunction ℝ => f n) (vaughan U V)\n  simp only [ArithmeticFunction.add_apply, sub_apply', trunc_apply, ite_eq_right (not_le.2 hn), zero_add] at h\n  exact h",
            "line": 43,
            "truncated": false
          },
          "proof_context": {
            "declaration": "TernaryGoldbach.MinorArcs.vaughan_apply",
            "lines": [
              42,
