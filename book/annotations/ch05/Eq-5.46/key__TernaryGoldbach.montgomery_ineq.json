            "text": "theorem montgomery_ineq {r : ℕ} (hr : Squarefree r) (s : Finset ℕ) (a : ℕ → ℂ)\n    (hs : ∀ n ∈ s, Nat.Coprime n r) (α : ℝ) :\n    ‖∑ n ∈ s, a n * e (α * n)‖ ^ 2 ≤\n      (Nat.totient r : ℝ) * ∑ b ∈ (range r).filter r.Coprime,\n        ‖∑ n ∈ s, a n * e ((α + b / r) * n)‖ ^ 2 :=",
